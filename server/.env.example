# 复制成 server/.env 后填写；不填则用设备号登录（本地开发不需要这些）
# 公众号（必须已认证的服务号）后台 → 设置与开发 → 基本配置
GORILLA_WECHAT_APPID=
GORILLA_WECHAT_SECRET=

# 网页授权回调，必须与后台「网页授权域名」同域，且是 https
GORILLA_OAUTH_CALLBACK=https://your-domain.com/api/auth/wechat/callback

# 可选：站点公网地址（用于拼接分享链接）
GORILLA_PUBLIC_BASE=https://your-domain.com

# 可选：管理员 deviceId（逗号分隔）；不填则首个登录用户成为管理员
GORILLA_ADMIN_DEVICES=

# 可选：管理员口令。后台页面输入一次即把当前用户提升为管理员（内部使用最方便）
GORILLA_ADMIN_CODE=

# 可选：数据库路径，默认 server/data.db
GORILLA_DB=
